{
  "name": "solasstec-portaria",
  "version": "1.0.0",
  "description": "Sistema de portaria para visitantes e agendamento de salas corporativas.",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive --if-present lint:fix",
    "test": "pnpm --recursive --if-present test",
    "format": "pnpm --recursive --if-present format",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:deploy": "pnpm --filter api prisma:migrate:deploy",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daviPeter07/Teste-Tecnico-Solasstec.git"
  },
  "bugs": {
    "url": "https://github.com/daviPeter07/Teste-Tecnico-Solasstec/issues"
  },
  "homepage": "https://github.com/daviPeter07/Teste-Tecnico-Solasstec#readme",
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "js-yaml@>=5.0.0 <=5.2.1": "5.2.2"
    }
  }
}
