generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Access {
  id            Int          @id(map: "acesso_pkey") @default(autoincrement()) @db.Integer
  visitorId     Int          @map("visitante_id") @db.Integer
  roomId        Int?         @map("sala_id") @db.Integer
  appointmentId Int?         @map("agendamento_id") @db.Integer
  enteredAt     DateTime?    @map("entrada_em") @db.Timestamptz(6)
  exitedAt      DateTime?    @map("saida_em") @db.Timestamptz(6)
  active        Boolean      @default(true) @map("ativo")
  createdAt     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)
  visitor       Visitor      @relation(fields: [visitorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "acesso_visitante_id_fkey")
  room          Room?        @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "acesso_sala_id_fkey")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "acesso_agendamento_id_fkey")

  @@map("acesso")
}

model Appointment {
  id        Int      @id(map: "agendamento_pkey") @default(autoincrement()) @db.Integer
  visitorId Int      @map("visitante_id") @db.Integer
  roomId    Int      @map("sala_id") @db.Integer
  startsAt  DateTime @map("inicio_em") @db.Timestamptz(6)
  endsAt    DateTime @map("fim_em") @db.Timestamptz(6)
  /// 1=PENDENTE, 2=CONFIRMADO, 3=CANCELADO, 4=FINALIZADO
  status    Int      @default(1) @db.SmallInt
  active    Boolean  @default(true) @map("ativo")
  createdAt DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agendamento_visitante_id_fkey")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "agendamento_sala_id_fkey")
  accesses  Access[]

  @@index([visitorId, startsAt, endsAt], map: "idx_agendamento_visitante_periodo")
  @@index([roomId, startsAt, endsAt], map: "idx_agendamento_sala_periodo")
  @@map("agendamento")
}

model Holiday {
  id          Int      @id(map: "feriado_pkey") @default(autoincrement()) @db.Integer
  date        DateTime @unique(map: "idx_feriado_data") @map("data") @db.Date
  description String   @map("descricao") @db.Text
  /// 1=NACIONAL, 2=ESTADUAL, 3=MUNICIPAL
  type        Int?     @map("tipo") @db.SmallInt
  active      Boolean  @default(true) @map("ativo")
  createdAt   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("feriado")
}

model Room {
  id                  Int                       @id(map: "sala_pkey") @default(autoincrement()) @db.Integer
  name                String                    @map("nome") @db.VarChar(100)
  /// dia_semana (Days of the Week), hora_abertura e hora_fechamento por dia_semana
  availability        Json                      @map("disponibilidade") @db.JsonB
  capacity            Int                       @map("capacidade") @db.Integer
  /// 1=Hora, 2=Dia, 3=Semana, 4=Mês
  capacityVariation   Int?                      @default(2) @map("variacao_capacidade") @db.SmallInt
  active              Boolean                   @default(true) @map("ativo")
  createdAt           DateTime                  @default(now()) @map("criado_em") @db.Timestamptz(6)
  appointments        Appointment[]
  accesses            Access[]
  responsibleHistory  RoomResponsible[]
  availabilityHistory RoomAvailabilityHistory[]

  @@map("sala")
}

model RoomResponsible {
  id         Int       @id(map: "sala_responsavel_pkey") @default(autoincrement()) @db.Integer
  roomId     Int       @map("sala_id") @db.Integer
  name       String    @map("nome") @db.Text
  validFrom  DateTime  @map("valido_de") @db.Timestamptz(6)
  validUntil DateTime? @map("valido_ate") @db.Timestamptz(6)
  active     Boolean   @default(true) @map("ativo")
  createdAt  DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "sala_responsavel_sala_id_fkey")

  @@index([roomId, validFrom], map: "idx_sala_responsavel_historico")
  @@map("sala_responsavel")
}

model RoomAvailabilityHistory {
  id           Int       @id(map: "sala_disponibilidade_historico_pkey") @default(autoincrement()) @db.Integer
  roomId       Int       @map("sala_id") @db.Integer
  availability Json      @map("disponibilidade") @db.JsonB
  validFrom    DateTime  @map("valido_de") @db.Timestamptz(6)
  validUntil   DateTime? @map("valido_ate") @db.Timestamptz(6)
  active       Boolean   @default(true) @map("ativo")
  createdAt    DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "sala_disponibilidade_historico_sala_id_fkey")

  @@index([roomId, validFrom], map: "idx_sala_disponibilidade_historico")
  @@map("sala_disponibilidade_historico")
}

model PriorityType {
  id            Int       @id(map: "tipo_prioridade_pkey") @default(autoincrement()) @db.Integer
  description   String    @unique(map: "idx_tipo_prioridade_descricao") @map("descricao") @db.VarChar(100)
  priorityLevel Int       @unique(map: "idx_tipo_prioridade_nivel") @map("nivel_prioridade") @db.SmallInt
  active        Boolean   @default(true) @map("ativo")
  createdAt     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  visitors      Visitor[]

  @@map("tipo_prioridade")
}

model Visitor {
  id             Int           @id(map: "visitante_pkey") @default(autoincrement()) @db.Integer
  name           String        @map("nome") @db.VarChar(100)
  document       String        @unique(map: "idx_visitante_documento") @map("documento") @db.VarChar(50)
  documentType   String        @map("tipo_documento") @db.VarChar(3)
  birthDate      DateTime      @map("data_nascimento") @db.Date
  hasDisability  Boolean       @default(false) @map("possui_deficiencia")
  priorityTypeId Int           @map("tipo_prioridade_id") @db.Integer
  photo          String?       @map("foto") @db.VarChar(255)
  active         Boolean       @default(true) @map("ativo")
  createdAt      DateTime      @default(now()) @map("criado_em") @db.Timestamptz(2)
  priorityType   PriorityType  @relation(fields: [priorityTypeId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "visitante_tipo_prioridade_id_fkey")
  appointments   Appointment[]
  accesses       Access[]

  @@index([name], map: "idx_visitante_nome")
  @@index([active], map: "idx_visitante_ativo")
  @@map("visitante")
}
